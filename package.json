{
  "name": "eva-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node scripts/dev-electron.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start:electron": "electron .",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "maplibre-gl": "6.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "main": "electron/main.cjs"
}
